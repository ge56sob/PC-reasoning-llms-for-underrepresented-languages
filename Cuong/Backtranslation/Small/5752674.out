f(x) &= \ln \left( \frac{x}{2-x} + a(x-1)^2 + b(x-1)^3 \right) \\
&> -2 \\
\frac{\ln (x)}{\ln (2-x)} + a(x-1)^2 + b(x-1)^3 &> -2 \\
