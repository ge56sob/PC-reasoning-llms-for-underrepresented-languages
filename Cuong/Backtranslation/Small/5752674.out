     \[
     \text{trace}_{\text{mod}} \left( \frac{\sigma_1}{\sigma_1^{-3}} \right) = \text{trace}_{\text{mod}} \left( \frac{\sigma_1^{-1}}{\sigma_1^{-3}} \right).
